# Backup directory (created by install/sync scripts)
.backup/

# Session-specific data (NEVER commit)
projects/
session-env/
history.jsonl
shell-snapshots/
debug/
todos/
tasks/
plans/
cache/
telemetry/
file-history/
stats-cache.json

# Plugin installations (reinstall on each machine)
plugins/
installed_plugins.json

# Machine-specific files (never tracked — each machine maintains its own)
CLAUDE.md             # Machine-specific identity, paths, context
settings.json         # Runtime config (model, effort, plugins, permissions)
mcp.json              # Copied from mcp.json.template by install script
settings.local.json   # Machine-specific permissions
.env                  # Machine-specific environment variables
*.local.md            # Machine-specific plugin settings

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Packaged skill archives (binary)
*.skill

# System files
.DS_Store
*.swp
*.log
*.bak
