{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(claude mcp add:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.github.com)",
      "mcp__github__get_file_contents",
      "mcp__filesystem__list_directory",
      "Bash(curl:*)",
      "mcp__filesystem__read_multiple_files",
      "WebFetch(domain:agentskills.io)",
      "Bash(test:*)",
      "Bash(node:*)",
      "Bash(claude:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "mcp__filesystem__read_text_file",
      "Bash(chmod:*)",
      "Bash(/Users/alexrosenkranz/.claude/hooks/session-start.sh:*)",
      "Bash(/Users/alexrosenkranz/.claude/hooks/pre-compact.sh)",
      "Bash(python3:*)",
      "mcp__filesystem__directory_tree",
      "Bash(du:*)",
      "Bash(wc:*)",
      "Bash(git init:*)",
      "Bash(tree:*)",
      "Bash(git add:*)",
      "Bash(./scripts/sanitize-check.sh:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "WebFetch(domain:brianlovin.com)",
      "Bash(gh api:*)",
      "Bash(for file in skills/agent-browser/SKILL.md skills/bun/SKILL.md skills/deslop/SKILL.md skills/favicon/SKILL.md skills/find-skills/SKILL.md skills/knip/SKILL.md skills/rams/SKILL.md skills/reclaude/SKILL.md skills/sentry/SKILL.md skills/simplify/SKILL.md)",
      "Bash(do echo \"=== $file ===\")",
      "Bash(done)",
      "Bash(for file in skills/skill-creator/SKILL.md skills/skill-creator/references/output-patterns.md skills/skill-creator/references/workflows.md skills/skill-creator/scripts/init_skill.py skills/skill-creator/scripts/package_skill.py skills/skill-creator/scripts/quick_validate.py)",
      "Bash(./install.sh:*)",
      "Bash(echo:*)",
      "mcp__filesystem__list_allowed_directories",
      "Bash(git checkout:*)",
      "Bash(./sync.sh:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create --title \"Migrate commands to skills\" --body \"$\\(cat <<''EOF''\n## Summary\n\n- Converts 22 commands to the skills format, which is now the recommended path forward in Claude Code\n- 11 commands become standalone skills with `disable-model-invocation: true` \\(plan, code-review, build-fix, refactor-clean, session-log, skill-create, instinct-status, instinct-export, instinct-import, evolve, project-setup\\)\n- 4 commands merged into existing skills as supporting files \\(python-guide -> python-pro, datadog-monitor -> homelab-helper, tdd + test-setup -> tdd-workflow\\)\n- 7 redundant commands deleted \\(learn, terraform-learn, code-teach, docker-debug, homelab-docker, astro-api-setup, new-project/project-init\\)\n- Removes commands section from install.sh and sync.sh\n- Updates CLAUDE.md to reflect skill-only architecture\n\nNo user-facing behavior changes — all `/name` invocations still work the same way.\nEOF\n\\)\")",
      "Bash(gh pr merge:*)",
      "Bash(git pull:*)",
      "Bash(git branch:*)",
      "Bash(agent-browser:*)",
      "Bash(npm install:*)",
      "Bash(git -C ~/Code/claude-code-config log --oneline -5)",
      "Bash(git -C ~/Code/claude-code-config diff statusline.sh)",
      "Bash(git -C ~/Code/claude-code-config add statusline.sh)",
      "Bash(git -C:*)",
      "Bash(fi)",
      "Bash(head:*)",
      "Bash(bash:*)",
      "Bash(echo '{}' | ~/.claude/statusline.sh 2>&1)",
      "WebSearch",
      "Skill(commit-commands:commit)",
      "Bash(~/.claude/skills/continuous-learning-v2/hooks/observe.sh pre:*)",
      "mcp__memory__read_graph",
      "Bash(gt:*)",
      "Bash(gt mail:*)",
      "Bash(gt convoy:*)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "model": "opusplan",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "sequential-thinking",
    "filesystem"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-logger.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/continuous-learning-v2/hooks/observe.sh pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/continuous-learning-v2/hooks/observe.sh post",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "_note_hooks": "PreToolUse/PostToolUse/SessionStart/PreCompact above are kept for local skill symlinks. When learning-system plugin is installed, these can be removed (plugin hooks.json handles them via CLAUDE_PLUGIN_ROOT).",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "greptile@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "agent-browser@agent-browser": true,
    "hookify@claude-code-plugins": false,
    "goldeneye-agents@arosenkranz-claude-plugins": false,
    "learning-system@arosenkranz-claude-plugins": false,
    "workflow-skills@arosenkranz-claude-plugins": false,
    "language-skills@arosenkranz-claude-plugins": false
  },
  "alwaysThinkingEnabled": false,
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "bypassPermissions": true,
  "disableBypassPermissionsMode": false
}
