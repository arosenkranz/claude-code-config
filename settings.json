      "WebFetch(domain:www.youtube.com)",
      "WebFetch(domain:channelsurfer.tv)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:brianlovin.com)",
      "WebFetch(domain:carlbarenbrug.com)",
      "WebFetch(domain:manuelmoreale.com)",
      "WebFetch(domain:agentskills.io)",
      "WebFetch(domain:app.terraform.io)",
