# Claude Code Configuration Paths
# Copy to ~/.claude/.env and customize for your machine

# Directory where Claude Code config is installed
export CLAUDE_CONFIG_DIR="$HOME/.claude"

# Obsidian vault location (for session logger hook)
export CLAUDE_VAULT_PATH="$HOME/Documents/main-vault"

# Session logging preferences
export CLAUDE_LOG_SESSIONS="true"
export CLAUDE_SESSION_LOG_DIR="${CLAUDE_VAULT_PATH}/Sessions"
